{
  "name": "makethe-team",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply makethe-team --local",
    "db:migrate:remote": "wrangler d1 migrations apply makethe-team --remote",
    "cf-typegen": "wrangler types",
    "seed:local": "wrangler d1 execute makethe-team --local --file=scripts/seed.sql",
    "show:local": "wrangler d1 execute makethe-team --local --file=scripts/show-fixtures.sql"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.0"
  }
}

{
  "name": "makethe-team",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "guide:capture": "CAPTURE=1 playwright test --grep @guide",
    "dev:browser": "wrangler dev --port 8787 --env-file test/browser/browser.env --local-upstream localhost:8787",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "icons:build": "node scripts/build-icons.mjs",
    "db:reset:local": "node scripts/reset-local-state.mjs",
    "db:migrate:local": "wrangler d1 migrations apply makethe-team --local",
    "db:migrate:remote": "wrangler d1 migrations apply makethe-team --remote",
    "cf-typegen": "wrangler types",
    "cf:plan": "tsx infra/cloudflare/plan.ts",
    "cf:apply": "tsx infra/cloudflare/apply.ts",
    "cf:verify": "tsx infra/cloudflare/verify.ts",
    "seed:local": "wrangler d1 execute makethe-team --local --command \"CREATE TABLE IF NOT EXISTS seed_guard (ok INTEGER)\" && wrangler d1 execute makethe-team --local --file=scripts/seed.sql",
    "show:local": "wrangler d1 execute makethe-team --local --file=scripts/show-fixtures.sql"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@better-auth/passkey": "^1.7.1",
    "better-auth": "^1.6.28",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}

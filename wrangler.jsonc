{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makethe-team",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Bounds the cost of a runaway invocation (Cloudflare has no account-level
  // spend cap — budget alerts only notify). Defaults are 30s for HTTP and 15
  // minutes for cron triggers on an hourly-or-longer interval, so this is a
  // reduction of 30x and 900x respectively.
  //
  // Measured August 2026: the holding page is ~0.5ms CPU (p50 in production,
  // 430 requests); recurrence expansion is ~0.2ms per game warm and ~0.5ms per
  // first-touch timezone; full materialisation including D1 writes is ~1.6ms
  // per game wall-clock, so 25 games run in ~41ms. 1000ms leaves roughly 25x
  // headroom over that, which matters because the daily materialisation cron is
  // the binding path here — terminating it means no fixtures get created.
  //
  // Not tighter, deliberately: the realistic risk is a bug looping forever, and
  // a loop blows through 200ms just as surely as 1000ms. CPU overage is $0.02
  // per million CPU-ms, so the cost difference between the two is a fraction of
  // a penny, while the false-termination risk is real. Revisit if the cron ever
  // approaches this in production.
  "limits": { "cpu_ms": 1000 },
  "triggers": {
    // Hourly. The sweep opens fixtures that have reached their open-at time
    // and sends the day-before reminders; an hour is the intended production
    // cadence (TR-8) and the granularity the reminder window is specified in.
    // This ran at "*/5 * * * *" through the M4/M5 testing phase so the owner
    // could iterate against real data without waiting an hour per cycle;
    // reverted 12 August 2026. `CRON_SWEEP` in src/cron/handler.ts must always
    // match this string exactly — `handleScheduled` throws on an unrecognised
    // cron, so changing one without the other breaks every invocation.
    "crons": ["0 * * * *", "15 3 * * *"]
  },
  "vars": {
    "NOTIFIER": "resend",
    "MAX_EMAILS_PER_DAY": "50",
    "EMAIL_FROM": "Make The Team <no-reply@makethe.team>",
    // Not secret — Better Auth's public base URL for issuing links against.
    // BETTER_AUTH_SECRET is a Worker secret (`wrangler secret put`), never here.
    "BETTER_AUTH_URL": "https://makethe.team",
    // M14 web push, live. The VAPID keypair was generated 18 August 2026 and
    // the private half set with `wrangler secret put VAPID_PRIVATE_KEY`.
    //
    // `VAPID_PUBLIC_KEY` is a var and not a secret on purpose: the browser
    // needs it as `applicationServerKey` for every `PushManager.subscribe()`,
    // so it ships to every device that turns notifications on. It is public
    // by construction, and nothing is gained by hiding it.
    //
    // These two must always change together. The public half is baked into
    // every subscription at creation time, so replacing the pair invalidates
    // every existing subscription permanently — see
    // `docs/runbooks/cloudflare.md` § VAPID_PRIVATE_KEY, which carries the
    // recovery procedure and the reason this is the one secret here that
    // cannot be rotated cheaply.
    //
    // `PUSH_NOTIFIER` must not be set to "webpush" unless the secret is
    // already in place: `requireBinding` runs at notifier construction, and
    // `createNotifier` is built on eight paths including the cron handler, so
    // vars-without-secret takes down cancellation, team publishing, joining,
    // erasure scheduling *and* the whole sweep — including reminder emails,
    // which have nothing to do with push.
    "PUSH_NOTIFIER": "webpush",
    "VAPID_PUBLIC_KEY": "BO6-1kl28K1JKC39scUluuKn7U4k41eMSjpMqZtG8I34bevIPe-fufdRKne5Ld573cFfHAbpiwGkI32xH46oZrA",
    "VAPID_SUBJECT": "mailto:ops@makethe.team"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makethe-team",
      "database_id": "3dd1de85-a391-44ec-98a2-9e04fd543919",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FIXTURE_CAPACITY", "class_name": "FixtureCapacity" }
    ]
  },
  // Durable Object class migrations — unrelated to the D1 `migrations_dir`
  // above despite the shared name.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FixtureCapacity"] }
  ],
  "routes": [
    { "pattern": "makethe.team", "custom_domain": true }
  ]
}

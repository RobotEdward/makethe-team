{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makethe-team",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "NOTIFIER": "console",
    "MAX_EMAILS_PER_DAY": "50"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makethe-team",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Bounds the cost of a runaway invocation (Cloudflare has no account-level
  // spend cap — budget alerts only notify). Defaults are 30s for HTTP and 15
  // minutes for cron triggers on an hourly-or-longer interval, so this is a
  // reduction of 30x and 900x respectively.
  //
  // Measured August 2026: the holding page is ~0.5ms CPU (p50 in production,
  // 430 requests); recurrence expansion is ~0.2ms per game warm and ~0.5ms per
  // first-touch timezone; full materialisation including D1 writes is ~1.6ms
  // per game wall-clock, so 25 games run in ~41ms. 1000ms leaves roughly 25x
  // headroom over that, which matters because the daily materialisation cron is
  // the binding path here — terminating it means no fixtures get created.
  //
  // Not tighter, deliberately: the realistic risk is a bug looping forever, and
  // a loop blows through 200ms just as surely as 1000ms. CPU overage is $0.02
  // per million CPU-ms, so the cost difference between the two is a fraction of
  // a penny, while the false-termination risk is real. Revisit if the cron ever
  // approaches this in production.
  "limits": { "cpu_ms": 1000 },
  // Workers rate limiting for the four unauthenticated token families
  // (TR-37), consumed by `src/security/rate-limit.ts`. GA since September
  // 2025; needs wrangler >= 4.36.0.
  //
  // These exist because the Free zone plan's own rate limiting rule is close
  // to useless as a control: it allows exactly **one** rule per zone, matching
  // on path only, counting per-IP over a fixed 10-second window with a
  // 10-second mitigation timeout. See `infra/cloudflare/` for the one rule the
  // zone does carry and what it is actually for (blocking before the Worker is
  // invoked, which protects the bill — the one thing these bindings cannot do).
  //
  // `period` may only be 10 or 60. `LIMIT_PERIOD_SECONDS` in
  // src/security/rate-limit.ts must match the 60 below — it is what the
  // `Retry-After` header on a refusal promises, and nothing can read the
  // configured period back off a binding at runtime.
  //
  // Counting is per Cloudflare location, not global, and Cloudflare documents
  // the API as "permissive, eventually consistent". Neither limit is a
  // guarantee; both are ceilings on hammering. The controls that actually
  // bound cost here are the notifier quota (`MAX_EMAILS_PER_DAY`) and token
  // unguessability, and every route must hold with these bindings absent —
  // they are optional in `Bindings` and the middleware fails open.
  "ratelimits": [
    // Per token: 10 requests a minute against one link. A player answering a
    // reminder taps two or three times at most, so this is roughly 3x the
    // busiest honest use of a single link.
    { "name": "TOKEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Per shared token: 200 a minute against one invite link. `/j/:token` and
    // `/join/:jtoken` carry one token for an entire squad — the game page tells
    // the organiser to share it in their group chat or hold up the QR code — so
    // the honest burst is a whole squad joining at once, at two requests each,
    // not one player tapping twice. At TOKEN_LIMITER's 10 the sixth person to
    // tap inside a minute got the too-many-requests page. Still a brake on
    // hammering one link; see SHARED_TOKEN_LIMITER in src/env.ts.
    { "name": "SHARED_TOKEN_LIMITER", "namespace_id": "1003", "simple": { "limit": 200, "period": 60 } },
    // Per IP: 60 a minute, deliberately loose. A whole office or mobile
    // network shares one address, and a false positive here breaks the one
    // journey the product depends on — see `TOKEN_IP_LIMITER` in src/env.ts.
    // Its job is bounding an attacker walking *different* tokens, which the
    // per-token key structurally cannot see.
    { "name": "TOKEN_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": {
    // Hourly. The sweep opens fixtures that have reached their open-at time
    // and sends the day-before reminders; an hour is the intended production
    // cadence (TR-8) and the granularity the reminder window is specified in.
    // This ran at "*/5 * * * *" through the M4/M5 testing phase so the owner
    // could iterate against real data without waiting an hour per cycle;
    // reverted 12 August 2026. `CRON_SWEEP` in src/cron/handler.ts must always
    // match this string exactly — `handleScheduled` throws on an unrecognised
    // cron, so changing one without the other breaks every invocation.
    "crons": ["0 * * * *", "15 3 * * *"]
  },
  "vars": {
    "NOTIFIER": "resend",
    // Resend's free tier allows 100 a day and 3,000 a month. 95 leaves a
    // little room under the hard daily cap for anything sent outside the
    // quota's own accounting, and lands at ~2,900 a month, inside the
    // monthly allowance. Raised from 80 in M42.
    "MAX_EMAILS_PER_DAY": "95",
    // M42 spill-over, shipped dark. Switching this to "cloudflare" adds a
    // second daily ceiling on top of the one above — see `selectEmailLeg`
    // in src/notify/factory.ts.
    //
    // It must NOT be switched on until makethe.team is onboarded as a
    // Cloudflare Email Service sending domain and its DKIM record is live,
    // and until SPF authorises both senders for the one EMAIL_FROM address
    // below. Turning it on first means every spilled message is sent
    // unauthenticated from a domain that already publishes SPF for Resend —
    // i.e. straight to spam, damaging the reputation of the address the
    // primary provider depends on.
    //
    // CLOUDFLARE_ACCOUNT_ID belongs in this block when that happens;
    // CLOUDFLARE_EMAIL_API_TOKEN is a secret (`wrangler secret put`),
    // never here.
    "EMAIL_SPILLOVER": "none",
    // Cloudflare includes 3,000 sends a month, then $0.35/1,000. 100 a day
    // lands at 3,000–3,100 a month, so this cap is also the cost guard —
    // see the binding's comment in src/env.ts. Unverified: Cloudflare's own
    // daily limit is a reputation ramp with no published starting figure,
    // so the real first-day allowance may be lower than this.
    "MAX_EMAILS_PER_DAY_CLOUDFLARE": "100",
    "EMAIL_FROM": "Make The Team <no-reply@makethe.team>",
    // Not secret — Better Auth's public base URL for issuing links against.
    // BETTER_AUTH_SECRET is a Worker secret (`wrangler secret put`), never here.
    "BETTER_AUTH_URL": "https://makethe.team",
    // M14 web push, live. The VAPID keypair was generated 18 August 2026 and
    // the private half set with `wrangler secret put VAPID_PRIVATE_KEY`.
    //
    // `VAPID_PUBLIC_KEY` is a var and not a secret on purpose: the browser
    // needs it as `applicationServerKey` for every `PushManager.subscribe()`,
    // so it ships to every device that turns notifications on. It is public
    // by construction, and nothing is gained by hiding it.
    //
    // These two must always change together. The public half is baked into
    // every subscription at creation time, so replacing the pair invalidates
    // every existing subscription permanently — see
    // `docs/runbooks/cloudflare.md` § VAPID_PRIVATE_KEY, which carries the
    // recovery procedure and the reason this is the one secret here that
    // cannot be rotated cheaply.
    //
    // `PUSH_NOTIFIER` must not be set to "webpush" unless the secret is
    // already in place: `requireBinding` runs at notifier construction, and
    // `createNotifier` is built on eight paths including the cron handler, so
    // vars-without-secret takes down cancellation, team publishing, joining,
    // erasure scheduling *and* the whole sweep — including reminder emails,
    // which have nothing to do with push.
    "PUSH_NOTIFIER": "webpush",
    "VAPID_PUBLIC_KEY": "BO6-1kl28K1JKC39scUluuKn7U4k41eMSjpMqZtG8I34bevIPe-fufdRKne5Ld573cFfHAbpiwGkI32xH46oZrA",
    "VAPID_SUBJECT": "mailto:ops@makethe.team"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makethe-team",
      "database_id": "3dd1de85-a391-44ec-98a2-9e04fd543919",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FIXTURE_CAPACITY", "class_name": "FixtureCapacity" }
    ]
  },
  // Durable Object class migrations — unrelated to the D1 `migrations_dir`
  // above despite the shared name.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FixtureCapacity"] }
  ],
  "routes": [
    { "pattern": "makethe.team", "custom_domain": true }
  ]
}

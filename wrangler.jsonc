{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makethe-team",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 * * * *", "15 3 * * *"]
  },
  "vars": {
    "NOTIFIER": "console",
    "MAX_EMAILS_PER_DAY": "50"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makethe-team",
      "database_id": "3dd1de85-a391-44ec-98a2-9e04fd543919",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "makethe.team", "custom_domain": true }
  ]
}

# Bindings for the browser suite's `wrangler dev`, loaded via --env-file
# (see `playwright.config.ts`). Committed on purpose: every value is an
# obviously-fake local-only dummy, which is also why CI needs no secret.
#
# This is deliberately NOT `.dev.vars`. That file is read by the Vitest
# workers pool as well, and it overrides the bindings `vitest.config.ts` sets
# explicitly — putting SIGNIN_ALLOWLIST and BETTER_AUTH_URL there turned 56
# server tests red, because every signed-in test suddenly had a different
# allowlist and origin from the one it asserts against.
#
# It is also not `--var KEY:VALUE`, which mangles any value containing a
# colon: `--var BETTER_AUTH_URL:http://localhost:8787` produced an origin
# that matched nothing, so every POST failed the same-origin check with a
# bare 403 "Forbidden" that reads like an auth bug.

# wrangler.jsonc says "resend", which throws here with no RESEND_API_KEY —
# into an error signin.ts deliberately swallows, so it fails invisibly.
NOTIFIER=console

# Without this, magic links are minted against https://makethe.team and the
# same-origin check on every POST compares against production's origin.
BETTER_AUTH_URL=http://localhost:8787

BETTER_AUTH_SECRET=local-browser-tests-only-not-a-real-secret
CANCEL_TOKEN_SECRET=local-browser-tests-only-not-a-real-cancel-secret
RESPONSE_TOKEN_SECRET=local-browser-tests-only-not-a-real-secret

# Suppresses the send for anything else. The harness does not depend on this
# — see the header of `test/browser/sign-in.ts` for why.
SIGNIN_ALLOWLIST=owner@example.test,player@example.test,jamie@example.test
